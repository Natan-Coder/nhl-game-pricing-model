# NHL Betting Model - Environment Configuration
# Copy this file to .env and fill in your actual values

# Database connection
DATABASE_URL=postgresql://username:password@localhost:5432/nhl_betting

# TheOdds API configuration
THEODDS_API_KEY=your_theodds_api_key_here
THEODDS_API_SPORT=icehockey_nhl
THEODDS_REGION=us
THEODDS_API_MARKETS=h2h,spreads,totals
THEODDS_API_ODDS_FORMAT=american
THEODDS_API_DATE_FORMAT=iso

# BallDontLie API (optional - requires paid subscription)
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here

# Betting configuration
BANKROLL=1000
POINT_SCALE=100

# Schedule ingestion settings
SCHEDULE_DAYS_AHEAD=7
SCHEDULE_DAYS_BACK=3

# Sportsbooks to track (comma-separated)
BOOKS=draftkings,fanduel,betmgm
