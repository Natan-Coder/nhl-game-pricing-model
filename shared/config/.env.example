# NHL Analytics Pipeline - Docker/Shared Configuration
# Copy this file to .env and fill in your actual values

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# For Supabase (cloud hosted):
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_password_here
POSTGRES_PORT=55432
POSTGRES_HOST=your-supabase-host.supabase.co

# For local development with Docker Postgres:
# POSTGRES_HOST=localhost

# ==============================================
# PGADMIN (Optional - for database management UI)
# ==============================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=choose_a_secure_password

# ==============================================
# FLYWAY DATABASE MIGRATIONS
# ==============================================
FLYWAY_SCHEMAS=public
FLYWAY_BASELINE_ON_MIGRATE=false

# ==============================================
# SPRING BOOT API CONFIGURATION
# ==============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
SERVER_PORT=8080
